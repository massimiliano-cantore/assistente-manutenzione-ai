# Copia in .env e completa. Il file .env non va MAI su GitHub (è in .gitignore).

# Modello linguistico: Groq offre un piano gratuito -> https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=

# Facoltativo: tracciamento delle esecuzioni su Langfuse (piano gratuito su cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Versione azienda (documentazione propria) ---
# Cartella con prodotti.yaml (quella scansionata con scripts.scansiona_documenti)
DATI_AZIENDA=
# Modello in locale per i documenti riservati: LLM_PROVIDER=ollama e LLM_MODEL=qwen3:14b
# Claude (API a consumo, console.anthropic.com): LLM_PROVIDER=anthropic e ANTHROPIC_API_KEY=...
LLM_MODEL=
# Ricerca datasheet: chiave della Search API di Mouser (non quella degli ordini); Tavily facoltativa
MOUSER_API_KEY=
TAVILY_API_KEY=
