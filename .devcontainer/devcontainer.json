{
  "name": "assistente-manutenzione-ai",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {"version": "22"}
  },
  "postCreateCommand": "pip install -r requirements-dev.txt && cd frontend && npm ci && npm run build",
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "Assistente", "onAutoForward": "openBrowser"}},
  "secrets": {
    "GROQ_API_KEY": {"description": "Chiave API di Groq (console.groq.com/keys)"}
  }
}
